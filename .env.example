# ═══════════════════════════════════════════
#  YOUTUBE MONSTER BOT — ШАБЛОН КОНФИГУРАЦИИ
#  Скопируй этот файл как .env и заполни!
#  cp .env.example .env
# ═══════════════════════════════════════════

# --- АВТОРИЗАЦИЯ TELEGRAM ---
# API_ID и API_HASH: https://my.telegram.org/apps
# BOT_TOKEN: @BotFather → /newbot
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- ВЛАДЕЛЕЦ И АДМИНЫ ---
# Telegram ID владельца бота (получить у @userinfobot).
# Если оставить 0 и включить USE_USERBOT — бот определит его сам
# по сессии юзербота при первом запуске.
OWNER_ID=0
# Доп. администраторы через запятую (ID, не username)
ADMIN_IDS=

# --- СИСТЕМА ---
# Папка для временных скачиваний
DOWNLOAD_DIR=./downloads

# --- ЮЗЕРБОТ (обход лимита 2 ГБ на файл у обычного бота) ---
# true — подключать личную сессию Telegram для загрузки файлов до 4 ГБ
# (нужен Telegram Premium на этом аккаунте). false — обычный лимит 2 ГБ.
USE_USERBOT=true

# --- БЫСТРЫЙ СТАРТ ---
# true — не показывать консольное меню при запуске, стартовать сразу
QUICK_START=false

# --- ПРОКСИ (для РФ) ---
# True, если используешь Happ/Hiddify для обхода блокировок TG.
# Для зарубежного VPS оставь False.
USE_PROXY=False
PROXY_HOST=127.0.0.1
PROXY_PORT=10808

# --- COOKIES ДЛЯ YOUTUBE ---
# Нужны для возрастных/приватных видео и чтобы снизить шанс блокировки
# по IP как "бот" (ошибка "Sign in to confirm you're not a bot").
#
# Вариант 1 (рекомендуется): куки берутся напрямую из браузера каждый раз —
# не протухают вручную, достаточно быть залогиненным в YouTube в этом браузере.
# Допустимые значения: chrome, firefox, edge, brave, opera, safari
BROWSER_COOKIES=

# Вариант 2: экспортированный файл (расширение "Get cookies.txt" и т.п.).
# Приоритетнее браузера, но ТОЛЬКО пока не устарел — см. COOKIE_MAX_AGE_HOURS ниже.
# Можно оставить пустым, бот сам поищет www.youtube.com_cookies.txt / cookies.txt рядом с bot.py.
COOKIE_FILE=

# Через сколько часов файл с куками считается протухшим и бот переключается
# на BROWSER_COOKIES (актуально, если часто меняешь IP/VPN и куки быстро "слетают")
COOKIE_MAX_AGE_HOURS=12

# --- ФОНОВЫЕ ПРОВЕРКИ (уведомления владельцу в Telegram) ---
# Как часто проверять, что куки ещё работают
COOKIE_CHECK_INTERVAL_HOURS=6
# Как часто проверять, не вышла ли новая версия yt-dlp
YTDLP_CHECK_INTERVAL_HOURS=24

# --- ПЛЕЙЛИСТЫ ---
# Сколько видео обрабатывать одновременно по умолчанию (1, 3, 5, 10)
DEFAULT_BATCH_SIZE=3

# --- PREMIUM (лимит 4 ГБ вместо 2 ГБ) ---
# Telegram ID и/или @username через запятую.
PREMIUM_USERS=123456789,987654321

# ═══════════════════════════════════════════
#  МОНИТОР-БОТ (channel_monitor.py) — отдельный процесс,
#  следит за YouTube-каналами и автопостит новые видео в канал
# ═══════════════════════════════════════════
# Токен ВТОРОГО бота (@BotFather → /newbot), добавь его админом
# в свой канал с правом публикации сообщений
MONITOR_BOT_TOKEN=

# Канал, куда публиковать (@username или -100xxxxxxxxxx)
TARGET_CHANNEL=@blogeridownload

# Как часто проверять каналы на новые видео (минуты)
MONITOR_POLL_INTERVAL_MINUTES=15

# Сколько последних видео канала смотреть за раз при проверке
MONITOR_VIDEOS_PER_CHECK=15

# Путь к списку отслеживаемых каналов (см. channels.example.json)
MONITOR_CHANNELS_FILE=channels.json

