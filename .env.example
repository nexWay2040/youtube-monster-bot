# ═══════════════════════════════════════════
#  YOUTUBE MONSTER BOT — ШАБЛОН КОНФИГУРАЦИИ
#  Скопируй этот файл как .env и заполни!
#  cp .env.example .env
# ═══════════════════════════════════════════

# --- АВТОРИЗАЦИЯ TELEGRAM ---
# API_ID и API_HASH: https://my.telegram.org/apps
# BOT_TOKEN: @BotFather → /newbot
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- СИСТЕМА ---
# Папка для временных скачиваний
DOWNLOAD_DIR=./downloads

# Видеокодер для транскода (VP9/AV1 → H.264):
#   h264_amf   — AMD Radeon (RX 6600 и др.)  ← рекомендуется для AMD
#   h264_nvenc — NVIDIA GeForce (GTX/RTX)
#   h264_qsv   — Intel QuickSync
#   libx264    — программный, на CPU (работает везде, медленнее)
VIDEO_ENCODER=libx264

# --- ПРОКСИ (для РФ) ---
# True, если используешь Happ/Hiddify для обхода блокировок TG.
# Для зарубежного VPS оставь False.
USE_PROXY=False
PROXY_HOST=127.0.0.1
PROXY_PORT=10808

# --- КУКИ БРАУЗЕРА (опционально) ---
# Для обхода JS-челленджей YouTube и доступа к возрастным видео.
# Допустимые значения: chrome, firefox, edge, brave, opera, safari
# Оставь пустым, если не нужно.
BROWSER_COOKIES=

# --- ПЛЕЙЛИСТЫ ---
# Сколько видео обрабатывать одновременно по умолчанию (1, 3, 5, 10)
DEFAULT_BATCH_SIZE=3

# --- PREMIUM (лимит 4 ГБ) ---
# Telegram ID через запятую. Остальные пользователи — лимит 2 ГБ.
PREMIUM_USERS=123456789,987654321